# Modèle sans secret pour une préproduction HTTPS. Remplacer chaque valeur
# placeholder dans l’environnement du fournisseur d’hébergement, jamais dans Git.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CRON_SECRET=GENERATE_A_RANDOM_CRON_SECRET
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_REAL_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_REAL_WEBHOOK_SECRET
NEXT_PUBLIC_APP_URL=https://preproduction.example.com
RESEND_API_KEY=re_REPLACE_WITH_REAL_RESEND_KEY
RESEND_FROM_EMAIL=GetYourMentor <notifications@your-verified-domain.example>

# Ne jamais renseigner ces variables en préproduction réelle :
# GETYOURMENTOR_ALLOW_DEMO=
# GETYOURMENTOR_ACCEPTANCE_MODE=
