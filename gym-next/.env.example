# Supabase côté serveur uniquement. Ne jamais exposer la service role key au navigateur.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Paiement optionnel en production : laisser PAYMENT_PROVIDER=local pour le mode démonstration.
PAYMENT_PROVIDER=local
STRIPE_SECRET_KEY=YOUR_SERVER_ONLY_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_SERVER_ONLY_STRIPE_WEBHOOK_SECRET
NEXT_PUBLIC_APP_URL=http://localhost:3001
RESEND_API_KEY=
RESEND_FROM_EMAIL=GetYourMentor <notifications@example.com>
