{
  "name": "gym-next",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:types": "tsc --noEmit --incremental false",
    "check:production-config": "node scripts/check-production-config.mjs",
    "check:preproduction-template": "node scripts/check-preproduction-template.mjs",
    "check:netlify-config": "node scripts/check-netlify-config.mjs",
    "check:supabase-schema": "node scripts/check-supabase-schema.mjs",
    "check:tracked-secrets": "node scripts/check-tracked-secrets.mjs",
    "check:client-secret-boundary": "node scripts/check-client-secret-boundary.mjs",
    "check:n8n-workflows": "node scripts/check-n8n-workflows.mjs",
    "check:production-safety": "node scripts/production-safety-smoke.mjs",
    "check:preproduction-runtime": "node scripts/preproduction-runtime-smoke.mjs",
    "validate:release-candidate": "npm run check:types && npm run check:netlify-config && npm run check:preproduction-template && npm run check:tracked-secrets && npm run check:n8n-workflows && npm run check:supabase-schema && npm run build && npm run check:client-secret-boundary && npm run check:production-safety && npx playwright test --reporter=line --workers=1",
    "pw:audit": "node scripts/run-playwright-audit.cjs",
    "pw:business": "playwright test tests/business-flow.spec.ts",
    "pw:headed": "node scripts/run-playwright-audit.cjs --headed",
    "pw:codegen": "playwright codegen http://127.0.0.1:3001"
  },
  "dependencies": {
    "next": "^15.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "overrides": {
    "postcss": "^8.5.28"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.16.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "22.14.1",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "typescript": "5.8.3"
  }
}
