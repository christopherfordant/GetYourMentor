    "AGENTS.md",
    "BRANCH_STRATEGY_GYM.md",
    "docs",
    "tools/agentic-workbench"
  ],
  "evidencePaths": [
    "docs/assets",
    "docs/multi-agent"
  ],
  "validationCommands": [
    {
      "id": "agentic-workbench-tests",
      "program": "node",
      "args": [
        "--test",
        "tools/agentic-workbench/tests/*.test.mjs"
      ],
      "cwd": "."
