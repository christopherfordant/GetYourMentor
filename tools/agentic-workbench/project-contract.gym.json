{
  "contractVersion": 1,
  "project": {
    "id": "getyourmentor",
    "name": "GetYourMentor"
  },
  "repositoryRoot": ".",
  "taskSource": {
    "format": "gym-kanban-v1",
    "path": "tools/agentic-workbench/backlog.json",
    "canonical": true
  },
  "instructions": [
    "AGENTS.md",
    "BRANCH_STRATEGY_GYM.md",
    "tools/agentic-workbench/AGENTS.md"
  ],
  "resumeFile": "docs/ETAT_REPRISE_COURANT.md",
